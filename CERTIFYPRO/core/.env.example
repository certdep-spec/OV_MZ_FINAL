# Налаштування CertifyPro через змінні середовища

# Шляхи (за замовчуванням відносно папки проєкту)
# CERTIFYPRO_DATA_DIR=data
# CERTIFYPRO_DB_PATH=data/certify.db
# CERTIFYPRO_TEMPLATES_DIR=templates
# CERTIFYPRO_DOCUMENTS_DIR=data/Documents
# CERTIFYPRO_LOGS_DIR=logs

# Рівень логування (DEBUG, INFO, WARNING, ERROR, CRITICAL)
CERTIFYPRO_LOG_LEVEL=INFO

# Приклад використання:
# CERTIFYPRO_DB_PATH=/var/certifypro/data/certify.db
